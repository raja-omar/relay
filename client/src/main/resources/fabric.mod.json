{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_author}"
	],
	"license": "${mod_license}",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.relay.RelayClientMod"
		]
	},
	"mixins": [
		"relay.mixins.json",
		"relay-sodium.mixins.json"
	],
	"depends": {
		"minecraft": "~${minecraft_version}",
		"fabricloader": ">=${loader_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"litematica": ">=${litematica_version}",
		"adventure-platform-fabric": "*",
		"owo": "*"
	}
}
